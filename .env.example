# ---------------------------------------------------------------------------
# v1: rein lokale Speicherung. Diese Datei nach `.env.local` kopieren, wenn vom
# Standard abgewichen werden soll. Ohne .env.local läuft alles im Modus "local".
# ---------------------------------------------------------------------------

# Woher die App ihre Daten bezieht.
#   local  = IndexedDB auf dem Gerät (Standard, v1)
#   remote = HTTP-Adapter gegen eine zentrale API (noch nicht implementiert,
#            siehe lib/data/remote/http-repository.ts)
NEXT_PUBLIC_DATA_MODE=local

# Schreibt jede Mutation zusätzlich in die Outbox-Tabelle `changeLog`.
# In v1 liest niemand diese Tabelle; sie ist die Grundlage für späteren Sync.
# Auf "off" setzen, wenn der Platzverbrauch stört.
NEXT_PUBLIC_CHANGE_LOG=on

# Basis-URL der späteren API. Nur relevant bei NEXT_PUBLIC_DATA_MODE=remote.
# NEXT_PUBLIC_API_BASE_URL=https://api.example.org

# ---------------------------------------------------------------------------
# Ab hier: alles für den späteren Server-Schritt. Bewusst auskommentiert —
# nichts davon wird in v1 gelesen. Reihenfolge der Einrichtung steht in
# docs/roadmap-server.md.
# ---------------------------------------------------------------------------

# Datenbank (Postgres). Erst nötig, wenn `output: 'export'` aus next.config.ts
# entfernt und ein Prisma-Schema angelegt wurde.
# DATABASE_URL=postgresql://user:passwort@localhost:5432/haushalt

# SSO über einen OIDC-Provider (Auth.js). AUTH_SECRET erzeugen mit:
#   openssl rand -base64 32
# AUTH_SECRET=
# AUTH_URL=http://localhost:3000
# AUTH_OIDC_ISSUER=https://login.example.org/realms/haushalt
# AUTH_OIDC_ID=
# AUTH_OIDC_SECRET=

# Rolle, die ein neu über SSO angemeldeter Nutzer bekommt, solange ihn kein
# Admin zugeordnet hat. Mögliche Werte: admin | member | viewer
# AUTH_DEFAULT_ROLE=member
